$TTL 86400
@       IN SOA  ns1.team2.net. root.team2.net. (
                1       ; Serial
                3600    ; Refresh
                1800    ; Retry
                1209600 ; Expire
                86400 ) ; Negative cache TTL

@       IN NS   ns1.team2.net.
ns1     IN A    192.168.2.12
www     IN A    192.168.2.5
db      IN A    192.168.2.7
